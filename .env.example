# Pax environment configuration.
# Copy to .env for local development. Never commit real secrets or credentials
# here or in .env — this file documents names, defaults, and meaning only.
# See docs/specs/architecture.md and docs/specs/debugging-and-observability.md
# for the authoritative behavior of each variable.

# Execution target for the Strands runtime.
# local     - development and deterministic-demo default; runs the adapter in-process.
# agentcore - proxies execution to a deployed Bedrock AgentCore runtime.
PAX_EXECUTION_TARGET=local

# Root directory for the SQLite database and local Strands session files.
# Defaults to .pax-data locally; Railway deployments set this to /data (a
# mounted persistent volume).
PAX_DATA_DIR=.pax-data

# Enables the local pack-authoring Strands agent, skill, and CLI commands.
# Must remain false in the public hackathon deployment, which exposes no
# writable authoring route.
PAX_AUTHORING_ENABLED=false

# Enables the debug/Runtime Inspector routes and the "Inspect run" UI control.
# The public fixture deployment enables this (read-only) so judges can inspect
# a correlated trace; set to false to disable debug routes and UI entirely.
PAX_DEBUG_ENABLED=true

# Controls how much detail debug/runtime payloads retain.
# fixture-full   - full safe payloads; only safe for seeded fixture cases with
#                  no private data (used by the public hackathon fixture).
# metadata-only  - default; user-entered cases only ever expose metadata and
#                  hashes, never raw notes or model content.
PAX_DEBUG_PAYLOAD_MODE=metadata-only

# Days of runtime/debug telemetry retained before pruning. Defaults to 7 and
# cannot exceed 30 in this build.
PAX_DEBUG_RETENTION_DAYS=7

# Overrides the default Bedrock model ID used by the Strands runtime.
# Default when unset: global.anthropic.claude-sonnet-4-6
PAX_MODEL_ID=

# AWS region for Bedrock/AgentCore calls. Defaults to us-east-1 when unset.
AWS_REGION=us-east-1

# Public origin of the deployed web app. Deployed browser requests are
# same-origin by default (Express serves both the API and the built web app);
# only set this if a separate origin is introduced, so CORS can allow exactly
# that origin. Leave unset for same-origin (local and standard Railway)
# deployments.
PAX_PUBLIC_ORIGIN=

# --- Optional: standard OpenTelemetry exporter (see debugging-and-observability.md) ---
# Configuring these enables an external OTEL exporter without changing Pax's
# own SQLite-backed event persistence. Leave unset to use Pax's built-in
# span processor only.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
