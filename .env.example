# Sift environment configuration.
# Copy to .env for local development. Never commit real secrets or credentials
# here or in .env — this file documents names, defaults, and meaning only.
# See docs/specs/architecture.md and docs/specs/debugging-and-observability.md
# for the authoritative behavior of each variable.

# Execution target for the Strands runtime.
# local     - development and deterministic-demo default; runs the adapter in-process.
# agentcore - proxies execution to a deployed Bedrock AgentCore runtime.
SIFT_EXECUTION_TARGET=local

# Root directory for the SQLite database and local Strands session files.
# Defaults to .sift-data locally; Railway deployments set this to /data (a
# mounted persistent volume).
SIFT_DATA_DIR=.sift-data

# Enables the local pack-authoring Strands agent, skill, and CLI commands.
# Must remain false in the public hackathon deployment, which exposes no
# writable authoring route.
SIFT_AUTHORING_ENABLED=false

# Enables the debug/Runtime Inspector routes and the "Inspect run" UI control.
# The public fixture deployment enables this (read-only) so judges can inspect
# a correlated trace; set to false to disable debug routes and UI entirely.
SIFT_DEBUG_ENABLED=true

# Controls how much detail debug/runtime payloads retain.
# fixture-full   - full safe payloads; only safe for seeded fixture cases with
#                  no private data (used by the public hackathon fixture).
# metadata-only  - default; user-entered cases only ever expose metadata and
#                  hashes, never raw notes or model content.
SIFT_DEBUG_PAYLOAD_MODE=metadata-only

# Days of runtime/debug telemetry retained before pruning. Defaults to 7 and
# cannot exceed 30 in this build.
SIFT_DEBUG_RETENTION_DAYS=7

# Overrides the default Bedrock model ID used by the Strands runtime.
# Default when unset: global.anthropic.claude-sonnet-4-6
SIFT_MODEL_ID=

# AWS region for Bedrock/AgentCore calls. Defaults to us-east-1 when unset.
AWS_REGION=us-east-1

# Public origin of the deployed web app. Deployed browser requests are
# same-origin by default (Express serves both the API and the built web app);
# only set this if a separate origin is introduced, so CORS can allow exactly
# that origin. Leave unset for same-origin (local and standard Railway)
# deployments.
SIFT_PUBLIC_ORIGIN=

# Registers Sift's OpenTelemetry TracerProvider at boot so the spans the
# Strands SDK already emits on every Graph/Swarm/agent/model/tool call are
# captured into the same runtime_events table the Runtime Inspector reads,
# with real span_id/parent_span_id links and real span-measured durations
# (apps/agent/src/runtime/otel-span-recorder.ts). Capture is entirely
# in-process and opens no socket, so a fixture run stays fully offline.
# Set to false to leave the global OTel API unregistered: every Strands span
# is then created and immediately discarded, exactly as before, and nothing
# else changes.
SIFT_TRACING_ENABLED=true

# --- OpenTelemetry export (optional, off unless set) ---
# Standard OpenTelemetry variables, read by @opentelemetry/exporter-trace-otlp-http
# itself rather than reinterpreted by Sift. Setting OTEL_EXPORTER_OTLP_ENDPOINT
# additionally attaches a BatchSpanProcessor + OTLPTraceExporter, sending the
# same spans onward (this is the hook an AWS X-Ray / ADOT collector would use).
# Leave both unset for a fully offline run: with no endpoint configured, no
# exporter is constructed and no network call is ever made. Neither variable
# changes Sift's own SQLite-backed event persistence.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
#
# Still not implemented, deliberately: setupMeter()/OTEL metrics, and W3C
# `traceparent` propagation between Railway and AgentCore. Sift's own
# runs.trace_id remains the id the Runtime Inspector's Overview renders, and
# every runtime_events row for a run carries it; a span row records the real
# OTel trace id alongside it, in attributes['otel.trace_id'].
