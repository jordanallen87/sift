  "identity": {
    "description": "Works out what a vehicle actually has to do -- for a household, a sole trader, or a business -- and compares candidate models against those needs on budget and non-negotiables, normalized deal terms, five-year ownership cost, safety and reliability records, and practical fit, to recommend which models are worth test driving.",
    "id": "car-purchase",
    "name": "Vehicle Selection",
    "tags": [
      "car-purchase",
      "vehicle",
      "webmcp-hero",
      "vehicle-selection",
    ],
    "version": "1.0.0",
  },
  "obligations": [
