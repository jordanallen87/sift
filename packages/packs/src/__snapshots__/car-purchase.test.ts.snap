  "schemaVersion": "1.0",
  "skills": [
    {
      "description": "Normalizes raw listing and dealer-offer terms into comparable structured fields (advertised price, mileage, mandatory add-ons, financing terms).",
      "id": "listing-normalizer",
    },
    {
      "description": "Computes each candidate's comparable out-the-door price, flags teaser-price/add-on/financing conflicts, and surfaces deal value relative to the household's stated budget.",
      "id": "deal-analysis",
    },
    {
      "description": "Computes a five-year total ownership cost estimate (fuel, maintenance, insurance, depreciation, financing) under shared assumptions applied consistently across candidates.",
      "id": "ownership-cost",
    },
    {
      "description": "Retrieves and compares crash-safety, driver-assistance, and reliability ratings from independent published sources, flagging disagreements between sources.",
      "id": "safety-reliability",
    },
    {
      "description": "Compares candidate cargo and rear-seat specifications against household needs and flags concerns that require test-drive or physical measurement.",
      "id": "household-fit",
    },
    {
      "description": "Synthesizes normalized deal, ownership-cost, safety/reliability, and household-fit evidence into a source-linked shortlist recommendation.",
      "id": "decision-synthesis",
    },
  ],
  "specialists": [
    {
      "allowedSkills": [
        "listing-normalizer",
        "deal-analysis",
      ],
      "allowedTools": [
        "listing-reader",
      ],
      "description": "Analyzes normalized listing and dealer-offer terms to compute comparable out-the-door price and evaluate hard-constraint and teaser-price conflicts.",
      "id": "deal-analyst",
    },
    {
      "allowedSkills": [
        "ownership-cost",
      ],
      "allowedTools": [
        "ownership-calculator",
      ],
      "description": "Computes five-year ownership cost estimates from shared assumptions and per-candidate specification data.",
      "id": "ownership-cost-analyst",
    },
    {
      "allowedSkills": [
        "safety-reliability",
      ],
      "allowedTools": [
        "safety-reliability-lookup",
      ],
      "description": "Retrieves and compares safety and reliability ratings across independent sources for each candidate.",
      "id": "safety-reliability-analyst",
    },
    {
      "allowedSkills": [
        "household-fit",
      ],
      "allowedTools": [
        "household-fit-matrix",
      ],
      "description": "Compares candidate specifications against household cargo, rear-seat, and comfort needs, and surfaces explicit unknowns requiring a test drive or physical measurement.",
      "id": "household-fit-analyst",
    },
    {
      "allowedSkills": [],
      "allowedTools": [
        "listing-reader",
        "safety-reliability-lookup",
      ],
      "description": "Evaluates provenance, recency, and contradictions across submitted evidence before it can satisfy an obligation.",
      "id": "source-challenger",
    },
    {
      "allowedSkills": [
        "decision-synthesis",
      ],
      "allowedTools": [
        "propose_recommendation",
      ],
      "description": "Synthesizes resolved evidence across all prior obligations into a source-linked shortlist recommendation, gated by its own GoalLoop validator and requiring human approval before the recommendation is recorded.",
      "id": "decision-synthesizer",
    },
  ],
  "tools": [
    {
      "description": "Reads normalized candidate listing and dealer-offer terms (advertised price, mileage, standard features, mandatory add-ons, financing terms) from fixture or bounded live listing sources.",
      "effect": "read_only",
      "id": "listing-reader",
      "requiresApproval": false,
    },
    {
      "description": "Computes a five-year total ownership cost estimate (fuel, maintenance, insurance, depreciation, financing) from shared assumptions and per-candidate inputs.",
      "effect": "read_only",
