# deliberately kept.
artifacts/
!artifacts/demo/
artifacts/demo/*
!artifacts/demo/sift-webmcp-demo-FINAL.mp4
!artifacts/demo/screenshots/
coverage/
playwright-report/
test-results/
.playwright-mcp/
.stryker-tmp/
reports/mutation/

# Env and secrets
.env
.env.local
.env.*.local
!.env.example

# Editor and OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Docker
.docker/

# Local runtime database (`.sift-data/sift.sqlite` locally, `/data` in deployment).
